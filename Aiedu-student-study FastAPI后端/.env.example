AIEDU_ENV=development
AIEDU_DATABASE_URL=mysql+pymysql://aiedu:change-me@localhost:3307/aiedu_v2?charset=utf8mb4
AIEDU_REDIS_URL=redis://:change-me@localhost:6379/0
AIEDU_QDRANT_URL=http://localhost:6333
AIEDU_JWT_SECRET=replace-with-at-least-32-random-characters
AIEDU_ACCESS_TOKEN_MINUTES=15
AIEDU_REFRESH_TOKEN_DAYS=7
AIEDU_CORS_ORIGINS=http://localhost:8080
AIEDU_ROCKETMQ_ENDPOINT=localhost:8081
AIEDU_ROCKETMQ_TOPIC=aiedu-ai-jobs
AIEDU_ROCKETMQ_LOG_DIR=./logs/rocketmq_python
AIEDU_ROCKETMQ_WORKER_CONCURRENCY=4
AIEDU_ROCKETMQ_INVISIBLE_DURATION_SECONDS=1800
AIEDU_ENABLE_MQ=true
# AI 接口、密钥和模型统一配置在项目根目录 .env.ai。
AIEDU_UPLOAD_DIR=./uploads
AIEDU_MAX_UPLOAD_BYTES=10485760
AIEDU_OBJECT_STORAGE_BACKEND=minio
AIEDU_MINIO_ENDPOINT=localhost:9000
AIEDU_MINIO_ACCESS_KEY=aiedu
AIEDU_MINIO_SECRET_KEY=aiedu-development
AIEDU_MINIO_BUCKET=aiedu-resources
AIEDU_QDRANT_COLLECTION=aiedu_course_resources_v2
AIEDU_EMBEDDING_BATCH_SIZE=64
AIEDU_RAG_CHUNK_SIZE_CHARS=1200
AIEDU_RAG_CHUNK_OVERLAP_CHARS=200
AIEDU_TAVILY_API_KEY=
AIEDU_TAVILY_BASE_URL=https://api.tavily.com/search
