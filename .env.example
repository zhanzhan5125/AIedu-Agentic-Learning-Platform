MYSQL_DATABASE=aiedu_v2
MYSQL_USER=aiedu
MYSQL_PASSWORD=replace-this-password
MYSQL_ROOT_PASSWORD=replace-this-root-password
REDIS_PASSWORD=replace-this-redis-password
AIEDU_ENV=production
AIEDU_DATABASE_URL=mysql+pymysql://aiedu:replace-this-password@mysql:3306/aiedu_v2?charset=utf8mb4
AIEDU_REDIS_URL=redis://:replace-this-redis-password@redis:6379/0
AIEDU_QDRANT_URL=http://qdrant:6333
AIEDU_JWT_SECRET=replace-with-at-least-32-random-characters
AIEDU_CORS_ORIGINS=http://localhost:8080
AIEDU_ROCKETMQ_ENDPOINT=rocketmq:8081
AIEDU_ROCKETMQ_TOPIC=aiedu-ai-jobs
AIEDU_ROCKETMQ_WORKER_CONCURRENCY=4
AIEDU_ROCKETMQ_INVISIBLE_DURATION_SECONDS=1800
AIEDU_ENABLE_MQ=true
# AI 接口、密钥和模型统一配置在 .env.ai（参考 .env.ai.example）。
AIEDU_UPLOAD_DIR=/app/uploads
AIEDU_MAX_UPLOAD_BYTES=10485760
AIEDU_OBJECT_STORAGE_BACKEND=minio
AIEDU_MINIO_ENDPOINT=minio:9000
AIEDU_MINIO_ACCESS_KEY=aiedu
AIEDU_MINIO_SECRET_KEY=aiedu-development
AIEDU_MINIO_BUCKET=aiedu-resources
AIEDU_QDRANT_COLLECTION=aiedu_course_resources_v2
AIEDU_EMBEDDING_BATCH_SIZE=64
AIEDU_RAG_CHUNK_SIZE_CHARS=1200
AIEDU_RAG_CHUNK_OVERLAP_CHARS=200
AIEDU_RAG_CHUNK_TARGET_TOKENS=550
AIEDU_RAG_CHUNK_MAX_TOKENS=800
AIEDU_RAG_CHUNK_OVERLAP_TOKENS=80
AIEDU_ENABLE_LOCAL_RERANKER=true
AIEDU_RERANKER_MODEL=BAAI/bge-reranker-base
MINIO_ROOT_USER=aiedu
MINIO_ROOT_PASSWORD=aiedu-development
